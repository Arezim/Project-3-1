<launch>
  <!-- Visual markers for targets A and B -->
  <node pkg="arm_nav_basics" type="marker_points.py" name="marker_points" output="screen" />

  <!-- Circling dynamic obstacle in planning scene -->
  <node pkg="arm_nav_basics" type="dynamic_obstacle.py" name="dynamic_obstacle" output="screen">
    <param name="motion_type" value="circle"/>

    <!-- Center of the circle around robot base -->
    <param name="center_x" value="-0.10"/>
    <param name="center_y" value="0.00"/>
    <param name="z"        value="0.90"/>

    <!-- Radius and angular speed -->
    <param name="radius"        value="0.45"/>
    <param name="angular_speed" value="0.25"/>

    <!-- Box size as seen by MoveIt -->
    <rosparam param="size">[0.10, 0.30, 0.90]</rosparam>

    <!-- Optional vertical bobbing -->
    <param name="z_wave_amp"  value="0.50"/>
    <param name="z_wave_freq" value="0.10"/>

    <!-- How often the obstacle pose is updated -->
    <param name="update_rate" value="5.0"/>
  </node>

  <!-- Dynamic replanning experiment with CSV logging -->
  <node pkg="arm_nav_basics"
        type="experiment_runner.py"
        name="replanner_experiment"
        output="screen">
    <param name="group_name" value="manipulator"/>
    <param name="frame_id" value="base_link"/>

    <!-- Time window of each executed slice -->
    <param name="slice_sec" value="1.4"/>

    <!-- Position tolerance for considering the goal reached -->
    <param name="goal_tolerance" value="0.03"/>

    <!-- Speed scaling (lower for real robot) -->
    <param name="vel_scale" value="0.25"/>
    <param name="acc_scale" value="0.25"/>

    <!-- How many goal reaches before switching to next planner -->
    <param name="episodes_per_planner" value="10"/>

    <!-- Planner list we rotate through -->
    <rosparam param="planner_ids">
      [
        "RRTConnectkConfigDefault",   # RRTCONNECT
        "RRTstarkConfigDefault",      # RRTSTAR
        "PRMkConfigDefault",          # PRM
        "PRMstarkConfigDefault",      # PRMSTAR
        "BKPIECEkConfigDefault",      # BKPIECE
        "LBKPIECEkConfigDefault",     # LBKPIECE
        "BiTRRTkConfigDefault",       # BITRRT (BiTRRT)
        "ABITstarkConfigDefault",     # ABITSTAR
        "SPARSkConfigDefault",        # SPARS
        "STRIDEkConfigDefault",       # STRIDE
        "BFMTkConfigDefault"          # BFMT
      ]
    </rosparam>

    <!-- CSV logging location -->
    <param name="csv_path" value="/root/dyn_ws/temp_csv/dyn_replanner_log.csv"/>
  </node>
</launch>
