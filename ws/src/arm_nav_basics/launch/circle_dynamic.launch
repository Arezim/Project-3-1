<launch>
  <!-- Visual markers for targets A / B -->
  <node pkg="arm_nav_basics" type="marker_points.py" name="marker_points" output="screen" />

  <!-- Circling dynamic obstacle (same as your experiment launch) -->
  <node pkg="arm_nav_basics" type="dynamic_obstacle.py" name="dynamic_obstacle" output="screen">
    <param name="motion_type" value="circle"/>

    <!-- Center of the circle (around robot base) -->
    <param name="center_x" value="-0.1"/>
    <param name="center_y" value="0.0"/>
    <param name="z"        value="0.9"/>

    <!-- Radius + speed -->
    <param name="radius" value="0.45"/>
    <param name="angular_speed" value="0.45"/>  <!-- rad/s -->

    <!-- Obstacle size in planning scene -->
    <rosparam param="size">[0.1, 0.3, 0.9]</rosparam>

    <!-- Optional vertical bobbing -->
    <param name="z_wave_amp" value="0.0"/>
    <param name="z_wave_freq" value="0.1"/>

    <!-- How often pose is updated -->
    <param name="update_rate" value="5.0"/>
  </node>

  <!-- Dynamic replanner (this replaces move_to_points.py in this scenario) -->
  <node pkg="arm_nav_basics" type="replanner.py" name="replanner" output="screen">
    <param name="group_name" value="manipulator"/>
    <param name="frame_id" value="base_link"/>

    <!-- Size of each executed slice (seconds of trajectory) -->
    <param name="slice_sec" value="1.4"/>

    <!-- Position tolerance for "goal reached" -->
    <param name="goal_tolerance" value="0.03"/>

    <!-- Speed scaling (tune these lower on the real robot) -->
    <param name="vel_scale" value="0.25"/>
    <param name="acc_scale" value="0.25"/>

    <!-- Targets; by default match marker_points.py, but overrideable -->
    <!--
    <rosparam param="target_A">{x: 0.60, y: 0.10, z: 0.95}</rosparam>
    <rosparam param="target_B">{x: -0.60, y: -0.50, z: 1.50}</rosparam>
    -->
  </node>
</launch>
