<launch>
  <!-- Markers for start / goal points -->
  <node pkg="arm_nav_basics" type="marker_points.py" name="marker_points" output="screen" />

  <!-- Simple two-point motion script -->
  <node pkg="arm_nav_basics" type="move_to_points.py" name="move_to_points" output="screen" />

  <!-- Optional: static obstacle if you want it back later -->
  <!--
  <node pkg="arm_nav_basics" type="static_obstacle.py" name="static_obstacle" output="screen" />
  -->

  <!-- Circling dynamic obstacle (same config as experiment launch) -->
  <node pkg="arm_nav_basics" type="dynamic_obstacle.py" name="dynamic_obstacle" output="screen">
    <!-- Circle around roughly the robot base -->
    <param name="motion_type" value="circle"/>

    <!-- Center of the circle (tune to where your arm base actually is) -->
    <param name="center_x" value="0.0"/>
    <param name="center_y" value="0.0"/>
    <param name="z"        value="0.9"/>  <!-- height of the box -->

    <!-- Radius + speed -->
    <param name="radius" value="0.35"/>
    <param name="angular_speed" value="0.75"/>  <!-- rad/s -->

    <!-- Size of the obstacle (collision box) -->
    <rosparam param="size">[0.2, 0.3, 0.9]</rosparam>

    <!-- Optional: vertical bobbing while circling (disabled here) -->
    <param name="z_wave_amp" value="0.0"/>
    <param name="z_wave_freq" value="0.3"/>

    <!-- How often the obstacle pose is updated -->
    <param name="update_rate" value="10.0"/>
  </node>
</launch>
