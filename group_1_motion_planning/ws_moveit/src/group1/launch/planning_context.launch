<launch>
  <!-- By default we do not overwrite the URDF. Change the following to true to change the default behavior -->
  <arg name="load_robot_description" default="false"/>
  <arg name="enable_fake_execution" default="false"/>

  <!-- The name of the parameter under which the URDF is loaded -->
  <arg name="robot_description" default="robot_description"/>

  <!-- Load universal robot description format (URDF) -->
  <param if="$(arg load_robot_description)" name="$(arg robot_description)" textfile="$(find group1)/config/final_setup.urdf"/>

  <!-- The semantic description that corresponds to the e   URDF -->
  <param name="$(arg robot_description)_semantic" textfile="$(find group1)/config/m_robot.srdf" />

  <!-- Load updated joint limits (override information from URDF) -->
  <group ns="$(arg robot_description)_planning">
    <rosparam unless="$(arg enable_fake_execution)" command="load" file="$(find m_robot_moveit_config)/config/joint_limits.yaml"/>
    <rosparam if="$(arg enable_fake_execution)" command="load" file="$(find m_robot_moveit_config)/config/joint_limits_fake.yaml"/>
    <rosparam command="load" file="$(find m_robot_moveit_config)/config/cartesian_limits.yaml"/>
  </group>

  <!-- Load default settings for kinematics; these settings are overridden by settings in a node's namespace -->
  <group ns="$(arg robot_description)_kinematics">
    <rosparam command="load" file="$(find m_robot_moveit_config)/config/kinematics.yaml"/>

  </group>

</launch>
