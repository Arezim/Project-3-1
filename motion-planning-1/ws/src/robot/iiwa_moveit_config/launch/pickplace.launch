<?xml version="1.0"?>
<launch>
  <!-- Run MTC pick and place -->
  <node name="mtc" pkg="moveit_task_constructor_demo" type="pick_place_demo" output="screen">
    <param name="execute" value="true" />
    <rosparam command="load" file="$(find iiwa_moveit_config)/config/iiwa_config.yaml" />
  </node>
</launch>